# Variáveis consumidas pelo docker-compose.yml.
# Copie para `.env` na raiz (já coberto pelo .gitignore) e preencha os segredos.

NODE_ENV=development

DB_USER=postgres
DB_DATABASE=bot_whatsapp
# OBRIGATÓRIO
DB_PASSWORD=

# OBRIGATÓRIO — mínimo de 32 caracteres.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OBRIGATÓRIO — segredo compartilhado entre o gateway do WhatsApp e o backend.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo
