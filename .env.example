# Variáveis consumidas pelo docker-compose.yml.
# Copie para `.env` na raiz (já coberto pelo .gitignore) e preencha os segredos.

NODE_ENV=development

DB_USER=postgres
DB_DATABASE=bot_whatsapp
# OBRIGATÓRIO
# ATENÇÃO: o Postgres só aplica esta senha no primeiro boot, quando cria o datadir.
# Se o volume `postgres_data` já existir, mudar aqui NÃO muda a senha do banco e o
# backend passa a falhar com `28P01 password authentication failed`. Nesse caso:
#   docker exec -i bot_whatsapp_db psql -U postgres -d postgres \
#     -v pw="$DB_PASSWORD" -f - <<< "ALTER USER postgres WITH PASSWORD :'pw';"
# ou apague o volume (`docker compose down -v`) para recriar o banco do zero.
DB_PASSWORD=

# OBRIGATÓRIO — mínimo de 32 caracteres.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OBRIGATÓRIO — segredo compartilhado entre o gateway do WhatsApp e o backend.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo

# Delay de humanização das respostas do robô (em segundos)
BOT_DELAY_MIN_SECONDS=10
BOT_DELAY_MAX_SECONDS=20
