PORT=5000
NODE_ENV=development

# Banco de dados
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=bot_whatsapp
DB_PASSWORD=postgres
DB_PORT=5432

# Redis (filas BullMQ + pub/sub de eventos de chat)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# OBRIGATÓRIO. Mínimo de 32 caracteres — a aplicação não sobe em produção sem isto.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OBRIGATÓRIO. Segredo compartilhado entre o gateway do WhatsApp e o backend,
# usado no header X-Internal-Key da rota POST /api/bot/webhook-event.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Origens de navegador permitidas (lista separada por vírgulas).
# Em produção, sem este valor nenhuma origem de navegador é aceita.
CORS_ORIGIN=http://localhost:5173

# Fuso usado para interpretar opening_time/closing_time e montar a agenda.
APP_TIMEZONE=America/Sao_Paulo
